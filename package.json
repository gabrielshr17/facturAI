{
  "name": "sistema-facturacion-real",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de facturación, inventario y gestión (República Dominicana)",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sfr/web dev",
    "dev:desktop": "pnpm --filter @sfr/desktop dev",
    "dev:api": "pnpm --filter @sfr/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @sfr/core db:migrate",
    "db:seed": "pnpm --filter @sfr/core db:seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0"
  }
}
