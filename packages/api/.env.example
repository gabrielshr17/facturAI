# Copiar a .env y rellenar cuando exista un proyecto real. Sin estas
# variables, el backend arranca igual mode "scaffold": /health responde,
# pero auth y transmisión e-CF devuelven placeholders (ver README.md).

PORT=3001

# Proyecto de Supabase (SOLO auth/autorización, ver plan.md decisión #2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto de PowerSync (sync motor para multi-caja/multiusuario).
POWERSYNC_URL=

# Chatbot con visión (Fase 3). Sin esto, /chatbot/* responde 501.
ANTHROPIC_API_KEY=
