# Copiar a .env y rellenar cuando exista un proyecto real. Sin estas
# variables, el backend arranca igual mode "scaffold": /health responde,
# pero auth y transmisión e-CF devuelven placeholders (ver README.md).

PORT=3001

# Proyecto de Supabase (SOLO auth/autorización, ver plan.md decisión #2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto de PowerSync (sync motor para multi-caja/multiusuario).
POWERSYNC_URL=

# Chatbot con visión (Fase 3). Sin esto, /chatbot/* responde 501.
ANTHROPIC_API_KEY=

# Últimas transferencias recibidas (§ plan.md): OAuth de la casilla Gmail dedicada que recibe,
# por reenvío automático desde las cuentas reales del negocio, las notificaciones bancarias.
# Sin estas tres variables, el sondeo no arranca (pero /transferencias/recientes sigue
# funcionando si ya hay filas guardadas). Ver README.md para cómo crear el OAuth client y
# obtener el refresh token.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Cada cuánto se sondea la casilla, en milisegundos. Por defecto 300000 (5 minutos).
TRANSFERENCIAS_POLL_INTERVALO_MS=

# Extracción de monto/fecha/banco/referencia del correo de transferencia (Gemini, no Claude —
# es independiente de ANTHROPIC_API_KEY de arriba). Sin esto, el sondeo tampoco arranca.
GEMINI_API_KEY=
