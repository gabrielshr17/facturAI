{
  "name": "@sfr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "caja-key": "tsx --env-file-if-exists=.env scripts/caja-key.ts",
    "set-pruebas": "tsx --env-file-if-exists=.env scripts/set-pruebas.ts",
    "firmar-xml": "tsx --env-file-if-exists=.env scripts/firmar-xml.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@google/genai": "^0.15.0",
    "@sfr/core": "workspace:*",
    "@supabase/supabase-js": "^2.115.0",
    "@xmldom/xmldom": "^0.9.12",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "googleapis": "^144.0.0",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.3.2",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
